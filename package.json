{
  "name": "greentube-petstore-automation",
  "version": "1.0.0",
  "private": true,
  "description": "API test automation for Swagger Petstore using TypeScript and Playwright.",
  "scripts": {
    "test": "playwright test",
    "test:report": "playwright show-report",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rickycec/greentube-petstore-automation.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/rickycec/greentube-petstore-automation/issues"
  },
  "homepage": "https://github.com/rickycec/greentube-petstore-automation#readme",
  "devDependencies": {
    "@cucumber/cucumber": "^13.2.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.0"
  }
}
